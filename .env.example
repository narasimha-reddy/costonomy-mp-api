# Template for .env.local (git-ignored): costonomy-mp-api's settings when it runs on this machine.
#   cp .env.example .env.local
# Fill in the lines marked CHANGE ME (ask for the values through the password manager); everything else is already
# right for the shared dev setup. Start everything with ./run.sh (or ./run.sh source for MP from source); every start
# first checks that these point at the dev MySQL and the dev databases, never production's.
# Servers never read this file: test and production use setenv.sh.

SPRING_PROFILES_ACTIVE=dev

# ── Shared dev MySQL (the same values in every Costonomy API's .env.local) ──────────
MYSQL_HOST=15.252.180.221
MYSQL_PORT=3306
# CHANGE ME: the dev MySQL login
MYSQL_USER=…
MYSQL_PASSWORD=…
# MP's database on it
MP_DB=costonomy_mp

# ── costonomy-common-api (the local Docker stack's) ───────────────────────────────
COMMON_URL=http://localhost:8082/costonomy-common-api
COMMON_JWKS_URI=http://localhost:8082/costonomy-common-api/.well-known/jwks.json
# CHANGE ME: MP's login to common-api (dev svc-mp) and its webhook secret
MP_CLIENT_SECRET=…
MP_WEBHOOK_SECRET=…

# ── The shared Docker stack (common-api, Core) lives in costonomy-api/local ─────────
# CHANGE ME: where you cloned costonomy-api
COSTONOMY_API_REPO=/Users/you/costonomy-api

# ── Files: product images and bills in S3, under mp/ ───────────────────────────────
# Local runs and testapi share the dev database, so they share the costonomy-test bucket too (production uses
# costonomy-generic). Inside mp/: suppliers/{org}/stores/{store}/sku-images/…, restaurants/{org}/outlets/{outlet}/…
# (public read), invoices/{outlet}/{yyyy-mm}/… (private, opened through expiring links).
# Without AWS keys, set both providers to LOCAL (files in ./var).
STORAGE_PROVIDER=S3
STORAGE_S3_BUCKET=costonomy-test
STORAGE_S3_PREFIX=mp/
STORAGE_BASE_URL=https://costonomy-test.s3.ap-south-1.amazonaws.com
INVOICE_STORAGE_PROVIDER=S3
INVOICE_S3_BUCKET=costonomy-test
INVOICE_S3_PREFIX=mp/
# CHANGE ME: an AWS key that may read and write costonomy-test/mp/*
AWS_ACCESS_KEY_ID=…
AWS_SECRET_ACCESS_KEY=…
AWS_REGION=ap-south-1

# ── Payments: Razorpay TEST mode (docs/RAZORPAY.md) ─────────────────────────────────
PAYMENT_PROVIDER=RAZORPAY
# CHANGE ME: the rzp_test_ key pair
RAZORPAY_KEY_ID=…
RAZORPAY_KEY_SECRET=…
# Any random string locally (Razorpay cannot reach this machine); on a server, the secret of the webhook you created
# in Razorpay's dashboard for that server's /costonomy-mp-api/api/v1/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=…

# ── Optional ───────────────────────────────────────────────────────────────────────
# Providers default to the mocks locally (payments, delivery, SMS, payouts); set them only to try a real one, e.g.
# PAYMENT_PROVIDER=RAZORPAY with RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET (test keys).
