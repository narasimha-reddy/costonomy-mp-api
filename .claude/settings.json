{
  "permissions": {
    "allow": [
      "Bash(mvn test*)",
      "Bash(mvn -q test*)",
      "Bash(mvn compile*)",
      "Bash(mvn clean install -DskipITs*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(ls*)",
      "Bash(grep*)",
      "Bash(find*)"
    ],
    "ask": [
      "Bash(mvn clean install:*)",
      "Bash(mvn verify*)",
      "Bash(mvn spring-boot:run*)",
      "Bash(git push*)",
      "Bash(git commit*)",
      "Bash(git reset*)",
      "Bash(git checkout*)",
      "Bash(rm *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./src/main/resources/application-local.properties)",
      "Read(./server.log)",
      "Read(./*.log)",
      "Read(./var/**)",
      "Read(./target/**)",
      "Edit(./.env*)",
      "Edit(./src/main/resources/application-local.properties)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-protected-files.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-unit-tests.sh", "timeout": 600 }
        ]
      }
    ]
  }
}
