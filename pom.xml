<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.2.1</version>
		<relativePath />
	</parent>

	<groupId>com.costonomy</groupId>
	<artifactId>costonomy-mp-api</artifactId>
	<version>0.1.0</version>
	<packaging>war</packaging>
	<name>Costonomy MP API</name>
	<description>Backend for the Costonomy Marketplace (Mandi)</description>

	<properties>
		<java.version>17</java.version>
		<maven.compiler.source>17</maven.compiler.source>
		<maven.compiler.target>17</maven.compiler.target>
		<testcontainers.version>1.21.3</testcontainers.version>
		<!--
		  Integration tests run in this many forked JVMs at once. Each fork is its own JVM with its own MySQL container
		  (AbstractIntegrationTest starts one per JVM), its own Spring contexts and its own random ports, so forks share no
		  database, port or static state; upload file names are UUIDs and the invoice tests use temp directories. Test
		  classes are NOT run concurrently inside one JVM: they share cached Spring contexts, a database and static test
		  doubles, and several are order-sensitive. 1 restores the old serial run:  mvn verify -Dit.forks=1
		  Measured on an 8-core laptop, clean build: 1 fork 19.8 min, 2 forks 11.2 min, 3 forks 10.7 min (the original, before
		  the test-speed changes, took 24.7 min). 2 is the default: nearly all of the gain, and it fits a 4-vCPU CI runner.
		-->
		<it.forks>2</it.forks>
		<!--
		  Extra JVM arguments for each integration-test fork. Empty on purpose: a fork keeps every Spring context it has
		  built (about 40 across the suite), and a flat -Xmx2g measured at 350% CPU of garbage collection for over an hour
		  where the JVM's own default (a quarter of RAM) finishes the serial suite in minutes. With several forks each holds
		  fewer contexts. To bound memory on a small machine, set it explicitly:  mvn verify -Dit.argLine=-Xmx3g
		-->
		<it.argLine></it.argLine>
		<!--
		  Docker Engine API version Testcontainers negotiates with.

		  Testcontainers 1.21.3 bundles docker-java 3.4.2, whose default negotiated
		  version is below 1.44. Docker Engine 25+ (Docker Desktop 29 reports
		  MinAPIVersion 1.44) rejects anything older with an opaque HTTP 400 whose
		  body is an empty Info struct — which Testcontainers reports as the very
		  unhelpful "Could not find a valid Docker environment", even though the
		  daemon is running and `docker info` works fine.

		  Pinning 1.44 is the floor that current engines accept. Override for an
		  engine older than Docker 25: -Ddocker.api.version=1.41
		-->
		<docker.api.version>1.44</docker.api.version>
		<springdoc.version>2.3.0</springdoc.version>
		<jjwt.version>0.12.3</jjwt.version>
		<shedlock.version>5.16.0</shedlock.version>
	</properties>

	<dependencies>
		<!-- ── Web ─────────────────────────────────────────────────────── -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<!-- provided: the servlet container supplies Tomcat for a WAR deploy -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-tomcat</artifactId>
			<scope>provided</scope>
		</dependency>

		<!-- ── Persistence ─────────────────────────────────────────────── -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!-- Flyway owns the schema. See docs/DECISIONS.md D-002. -->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-mysql</artifactId>
		</dependency>

		<!-- ── Cache / coordination ────────────────────────────────────── -->
		<!-- Redis is cache, rate limiting and short-lived locks only. It is
		     never authoritative for money, orders or credit (guardrail 6). -->
		<!--
			Realtime. Doc 06 §9 and v2.2 §23A.21 put WebSocket first, with push and
			polling behind it — the socket is the fast path, not the only one.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-websocket</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis</artifactId>
		</dependency>

		<!-- ── Security ────────────────────────────────────────────────── -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<!-- Sign-in, access and webhooks from costonomy-common-api (common tokens, scope-aware access). -->
		<dependency>
			<groupId>com.costonomy</groupId>
			<artifactId>costonomy-security-starter</artifactId>
			<version>0.1.0-SNAPSHOT</version>
		</dependency>

		<!-- ── Scheduled jobs ──────────────────────────────────────────── -->
		<!-- ShedLock so supplier-timeout and reconciliation jobs run once
		     across instances rather than once per instance. -->
		<dependency>
			<groupId>net.javacrumbs.shedlock</groupId>
			<artifactId>shedlock-spring</artifactId>
			<version>${shedlock.version}</version>
		</dependency>
		<dependency>
			<groupId>net.javacrumbs.shedlock</groupId>
			<artifactId>shedlock-provider-jdbc-template</artifactId>
			<version>${shedlock.version}</version>
		</dependency>

		<!-- ── API documentation ───────────────────────────────────────── -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>${springdoc.version}</version>
		</dependency>

		<!-- ── Observability ───────────────────────────────────────────── -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!-- ── JSON ────────────────────────────────────────────────────── -->
		<dependency>
			<groupId>com.fasterxml.jackson.datatype</groupId>
			<artifactId>jackson-datatype-jsr310</artifactId>
		</dependency>

		<!-- ── Catalog import (doc 25, doc 40: CSV and XLSX) ───────────── -->
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-csv</artifactId>
			<version>1.11.0</version>
		</dependency>
		<dependency>
			<groupId>org.apache.poi</groupId>
			<artifactId>poi-ooxml</artifactId>
			<version>5.2.5</version>
		</dependency>

		<!-- ── Tooling ─────────────────────────────────────────────────── -->
		<!--
			Hot restart for local development: a changed class is reloaded in about
			three seconds instead of the fifteen a full `spring-boot:run` costs.

			`provided` rather than `optional`, because this module packages a WAR and
			an optional dependency is still copied into WEB-INF/lib. Provided keeps it
			on the local run and test classpath and out of the artifact entirely, which
			is a stronger guarantee than relying on the repackager to strip it.

			Restart is switched off by default in application.properties and enabled
			only under the `local` profile, so devtools cannot alter behaviour anywhere
			it might reach by accident.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>provided</scope>
		</dependency>

		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<version>1.18.36</version>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-lang3</artifactId>
		</dependency>

		<!-- ── Test ────────────────────────────────────────────────────── -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Real MySQL 8 for integration and migration tests. H2 would verify
		     migrations against a database we never deploy to. See D-007. -->
		<!-- Architecture rules (module boundaries, layering) as unit tests. -->
		<dependency>
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit-junit5</artifactId>
			<version>1.3.0</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>mysql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<!--
			S3, for user-uploaded images. Not active by default: the storage port
			selects LocalFileStorage unless costonomy.mp.storage.provider=S3, so
			neither a bucket nor credentials are needed to run, to test, or to
			develop the whole upload path against.
		-->
		<dependency>
			<groupId>software.amazon.awssdk</groupId>
			<artifactId>s3</artifactId>
			<version>2.25.16</version>
			<exclusions>
				<!-- Netty ships with the async client, which we do not use. -->
				<exclusion>
					<groupId>software.amazon.awssdk</groupId>
					<artifactId>netty-nio-client</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<!-- costonomy-common-api's signing keys for integration tests (JWKS served by WireMock). -->
		<dependency>
			<groupId>org.wiremock</groupId>
			<artifactId>wiremock-standalone</artifactId>
			<version>3.6.0</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.testcontainers</groupId>
				<artifactId>testcontainers-bom</artifactId>
				<version>${testcontainers.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<finalName>costonomy-mp-api</finalName>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
				<executions>
					<!-- META-INF/build-info.properties: /actuator/info reports the build time, which deploy.sh
					     matches to know the new version is the one answering. -->
					<execution>
						<goals>
							<goal>build-info</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- Unit tests run everywhere. Integration tests need Docker, so
			     they are a separate execution bound to `verify` and are skipped
			     when Docker is unavailable — see AbstractIntegrationTest. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<excludedGroups>integration</excludedGroups>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<configuration>
					<groups>integration</groups>
					<includes>
						<include>**/*Test.java</include>
						<include>**/*IT.java</include>
					</includes>
					<forkCount>${it.forks}</forkCount>
					<!-- Reused: the MySQL container is a static started once per JVM; a fresh JVM per class would start one each. -->
					<reuseForks>true</reuseForks>
					<argLine>${it.argLine}</argLine>
					<systemPropertyVariables>
						<!-- docker-java reads this system property; the
						     DOCKER_API_VERSION env var is NOT consulted here. -->
						<api.version>${docker.api.version}</api.version>
					</systemPropertyVariables>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
